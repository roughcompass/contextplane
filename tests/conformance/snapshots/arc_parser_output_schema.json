  "ParserRefusal": {
    "additionalProperties": false,
    "description": "A bounded refusal to parse. Carries no source bytes or parser\ndiagnostic text -- only the closed code naming why.",
    "properties": {
      "refusal_code": {
        "enum": [
          "unsupported_media_type",
