      ]
    },
    "accepted_by_subject": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseline_revision_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": [
        "string",
        "null"
      ]
    },
