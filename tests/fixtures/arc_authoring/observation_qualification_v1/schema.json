          },
          "unexplained_count": {
            "type": "number"
          }
        },
        "required": [
          "delta_code",
          "explained_count",
          "unexplained_count"
        ],
        "type": "object"
      },
      "type": "array",
      "x-array-kind": "ordered",
      "x-order-key": "delta_code"
    },
    "eligible_count": {
      "type": "number"
    },
    "engine_configuration_version": {
      "type": "string"
    },
