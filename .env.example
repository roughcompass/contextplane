# =============================================================================
# registry — environment variable reference (canonical inventory)
# =============================================================================
#
# This file is the deployment-target-neutral spec for every env var the app
# reads. Operators on Kubernetes, AWS ECS/Fargate, AWS Lambda, EC2/systemd,
# Cloud Run, App Runner, Nomad, etc. consume the same env vars — only the
# wiring differs. Helm chart values, Docker Compose, and any per-platform
# config you write should mirror this file.
#
# Conventions:
#   - Required vars have NO default; the app raises on startup if absent.
#   - Optional vars show the shipped default after the `=`.
#   - Defaults here MUST match registry/config.py `Settings`/`from_env`.
#   - Code outside registry/config.py that reads os.environ directly is
#     either consolidated into Settings or tagged `# config: intentional`.
#
# Use: copy to `.env` for local development (gitignored), or use it as the
# reference list when populating a ConfigMap / task-definition / systemd
# EnvironmentFile.

# -----------------------------------------------------------------------------
# Database — REQUIRED
# -----------------------------------------------------------------------------

# Async (asyncpg) connection string. The app process talks to PgBouncer in
# production; migrations talk to Postgres directly.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/registry

# Optional separate URL for the runtime app -> PgBouncer path. Defaults to
# DATABASE_URL when unset.
# PGBOUNCER_URL=postgresql+asyncpg://user:password@pgbouncer:6432/registry

# Optional URL used by APScheduler's SQLAlchemyJobStore for durable job rows.
# Defaults to DATABASE_URL. When SCHEDULER_USE_MEMORY_JOBSTORE=true this is
# ignored (jobs are in-process and lost on restart).
# SCHEDULER_JOBSTORE_URL=postgresql+asyncpg://user:password@host:5432/registry

# Fall back to APScheduler's MemoryJobStore (no DB persistence). Set to
# "true" / "1" / "yes" for local dev when you don't want job rows in PG.
SCHEDULER_USE_MEMORY_JOBSTORE=false

# -----------------------------------------------------------------------------
# Embedding
# -----------------------------------------------------------------------------

# Which implementation produces vectors:
#   onnx                  in-process ONNX Runtime over the artifact staged at
#                         EMBEDDING_MODEL_PATH. The default. No network access.
#   sentence_transformers reference implementation; needs the optional torch
#                         extra (`pip install "registry[torch]"`), ~750 MB more.
#   http                  a remote OpenAI-compatible endpoint; see below.
#   stub                  zero vectors. Smoke tests only — search still answers,
#                         but every semantic distance is identical, so ranking
#                         falls to the lexical arm.
# A provider that cannot load stops the app. There is no automatic downgrade to
# zero vectors: those rows are indistinguishable from real ones once written.
EMBEDDING_PROVIDER=onnx

# --- Session-observation extraction ---
# Which provider turns captured session events into candidate claims. This is
# the only place the registry talks to an LLM, and it is entirely optional.
#   noop       the default. Extraction pauses. Sessions are still captured and
#              replayed, and connector-fed claims still land -- a deployment
#              that never sets this is complete, not degraded.
#   local      deterministic pattern rules. No key, no network, no model. What
#              the local dev stack runs, so nothing downstream of extraction
#              needs a credential to work on. Output quality reflects the rule
#              set rather than a model; do not benchmark extraction against it.
#   anthropic  a real model. Needs EXTRACTION_API_KEY.
#   openai     any endpoint speaking /v1/chat/completions with tool calling,
#              which is most of them -- OpenAI, Azure, Groq, Together, vLLM,
#              Ollama, LiteLLM, and the majority of internal gateways. Point
#              EXTRACTION_BASE_URL at one and set EXTRACTION_API_KEY.
# An unrecognized value stops the app rather than falling back to noop: a
# deployment producing no claims because of a typo looks exactly like one whose
# sessions contain nothing extractable.
EXTRACTION_PROVIDER=noop

# How often staged claims are reconciled against one another -- duplicates collapsed,
# conflicts resolved by authority then recency. Far wider than the embedding poll
# because a decision can cost a provider call, and safe to widen because the work is
# idempotent: a longer interval only means an answer can be staler, never wrong.
CONSOLIDATION_SWEEP_INTERVAL_S=300

# How often consolidated claims are proposed for promotion, and auto-accepted where a
# tenant's own guardrails permit it (allowlist empty by default, so nothing does on a
# fresh deployment). Same idempotency argument as the consolidation sweep above: a
# longer interval only makes the review queue and the canonical graph staler.
PROMOTION_SWEEP_INTERVAL_S=300

# How often judged adjudications are refit into calibration mappings, one
# extraction strategy at a time. Hours-scale rather than minutes-scale like the
# sweeps above: a mapping needs a couple hundred judged outcomes before it is
# even stored, so a longer interval only delays how soon a fresh mapping
# reflects the latest judged claims, never changes what it converges to.
CALIBRATION_REFIT_INTERVAL_S=21600

# Model requested by the extraction strategies. Ignored by the noop and local
# providers, which have no model to select. Leaving it at the default keeps the
# calibration key -- (provider_id, model_id, strategy_id) -- pointing at the same
# mappings a deployment has already accumulated, which is why changing it is a
# deliberate act rather than a tidy-up.
EXTRACTION_MODEL=claude-haiku-4-5-20251001

# Per-call ceiling for the extraction provider, in seconds. Extraction is never
# on the ingest hot path, so a generous timeout costs queue latency rather than
# request latency.
EXTRACTION_TIMEOUT_S=60

# Credential for whichever provider needs one. Operator-supplied at deploy time
# (Kubernetes Secret, ECS secret ref, systemd EnvironmentFile) and never
# committed.
#
# EXTRACTION_API_KEY is the canonical name. CLAUDE_API_KEY and ANTHROPIC_API_KEY
# are accepted as deprecated aliases so existing deployments and runbooks keep
# working; when more than one is set the canonical name wins, and declaration
# order is what makes that so. There is deliberately no warning when a legacy
# name supplies the value: the alias mechanism discards which name it came from,
# and a warning that cannot tell whether the thing it warns about happened is
# worse than none.
# EXTRACTION_API_KEY=
# CLAUDE_API_KEY=
# ANTHROPIC_API_KEY=

# Endpoint extraction calls. Empty means the selected adapter's own vendor
# default, which is what keeps a deployment that configured none of these
# working exactly as it did before they existed.
#
# SECURITY-RELEVANT AND CHANGE-CONTROLLED. This is where session transcripts are
# sent. Pointing it somewhere new sends conversation content to a new operator,
# so it belongs under the same review as any other data-egress change -- not in
# an ad-hoc config edit. A non-https value warns at startup and is only
# defensible on loopback or a trusted in-cluster address. A URL carrying
# userinfo (user:pass@host) is refused outright.
# EXTRACTION_BASE_URL=

# Header the credential is sent in, and how it is spelled inside that header.
# Both empty means the adapter's own default, which differs by vendor:
# `x-api-key` with a bare value for the anthropic adapter, `Authorization` with
# `Bearer {key}` for the OpenAI-compatible one. The template must contain the
# literal {key} exactly once -- zero occurrences would validate a pasted
# credential into a non-secret setting bound for the ConfigMap.
# EXTRACTION_AUTH_HEADER=
# EXTRACTION_AUTH_TEMPLATE=

# Anything else the endpoint requires, as Name:value,Name:value.
#
# Treated as a secret rather than as plain config because gateways routinely
# authenticate with a second header, so this variable carries credentials in
# practice whether or not it does in a given deployment. It never appears in
# repr(Settings()) and error paths report header names only. The auth header,
# content-type, host, content-length, transfer-encoding and connection cannot be
# set through it; anthropic-version can.
# EXTRACTION_EXTRA_HEADERS=

# Identifies the embedding space. Stamped into embeddings.model_id, and the
# semantic arm only matches rows carrying the current value — so changing it
# hides every existing embedding until a reindex writes rows under the new id.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Where the model artifact lives. Container images bake it in at this path.
# To stage it elsewhere — including from an internal mirror or a local copy:
#   python scripts/fetch_embedding_model.py --out DIR [--source URL_OR_DIR]
EMBEDDING_MODEL_PATH=/opt/models/all-MiniLM-L6-v2

# Stored vector width. Must match both the model and the embeddings.vector
# column; the app refuses to start when it disagrees with the live schema.
# Changing it means deleting and recomputing every embedding — see
# docs/06-operations/ on restricted-network deployment before touching it.
EMBEDDING_DIM=384

# Token budget per chunk when splitting fact bodies for embedding.
EMBEDDING_CHUNK_TOKENS=400

# LRU cache size for previously-embedded chunks.
EMBEDDING_CACHE_MAXSIZE=10000

# --- Remote embedding provider (EMBEDDING_PROVIDER=http only) ---
# OpenAI-compatible endpoint: POST {"input": [...], "model": "..."} returning
# {"data": [{"index": n, "embedding": [...]}]}. Leave unset for local providers.
# EMBEDDING_HTTP_ENDPOINT=https://llm-gateway.internal/v1/embeddings
EMBEDDING_HTTP_CONNECT_TIMEOUT_MS=500
EMBEDDING_HTTP_READ_TIMEOUT_MS=5000
EMBEDDING_HTTP_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Outbox + drain
# -----------------------------------------------------------------------------

# Drain interval (seconds) for the embedding outbox.
OUTBOX_POLL_INTERVAL_S=5

# How often the closure-cache drain runs. Edge mutations enqueue refresh work;
# this drain applies it. Traversals stay correct without it (they fall back to
# a recursive CTE) but pay the fallback cost on every read after an edge change.
CLOSURE_REFRESH_INTERVAL_S=5

# Max rows claimed per drain pass.
OUTBOX_BATCH_SIZE=32

# Per-row retry ceiling before the outbox row moves to the dead-letter table.
OUTBOX_MAX_ATTEMPTS=5

# Page size for the backfill / reindex scripts.
BACKFILL_BATCH_SIZE=64

# -----------------------------------------------------------------------------
# Webhook delivery
# -----------------------------------------------------------------------------

# Cadence for the WebhookDeliveryWorker drain job. The p95 SLO caps fan-out
# at 30 s; the default 5 s keeps you well inside the SLO with headroom for retries.
WEBHOOK_DRAIN_INTERVAL_S=5

# Per-delivery HTTP timeout (seconds).
WEBHOOK_REQUEST_TIMEOUT_S=10.0

# Max deliveries claimed per drain pass.
WEBHOOK_BATCH_SIZE=50

# -----------------------------------------------------------------------------
# HTTP method routing
# -----------------------------------------------------------------------------

# Which mutation surface to register:
#   rest      — only the standard verb (PATCH / DELETE / etc.). DEFAULT.
#   post_only — only POST-tunneled aliases (POST .../{id}:update etc.).
#   both      — both routes registered. Set this only if you operate behind
#               an enterprise proxy that strips non-GET/POST verbs.
REGISTRY_HTTP_METHODS_MODE=rest

# Separator between resource path and action suffix in the POST-tunneled
# alias. "colon" → /{id}:update; "slash" → /{id}/update.
REGISTRY_HTTP_METHOD_ALIAS_SEPARATOR=colon

# -----------------------------------------------------------------------------
# Auth + OIDC
# -----------------------------------------------------------------------------
#
# The registry accepts OIDC JWT credentials, validated against an IdP's
# discovery document and resolved through the entitlement service. Pick
# the audience:
#
#   1. Production (humans, service accounts, CI). Set OIDC_DISCOVERY_URL
#      to your IdP's discovery document. Works with any provider that
#      implements OpenID Connect (Okta, Azure AD, Auth0, Keycloak,
#      Google Workspace, …). The token must carry `sub` and
#      `tenant_id`/`tid` claims; the matching actor is JIT-materialized
#      on first entitlement.
#
#   2. Local development. Run `make dev-token` (idempotent — seeds a
#      tenant + actor and registers a client + canned entitlements
#      against the local mock OIDC and mock entitlement services).
#      Mock-IDP credentials land in `.env.dev`; fetch a JWT from
#      `<MOCK_OIDC_URL>/default/token` via `grant_type=client_credentials`
#      and use it like any other OIDC token.
#
# Both forms hit the same middleware path: JWT validation against an
# OIDC discovery URL + entitlement-service lookup. The dev variant just
# points at local mock services instead of a corporate IdP. See
# `docs/01-overview/04-authentication.md` for the JWT validation
# contract and `docs/01-overview/05-authorization.md` for how grants
# resolve to a TenantContext.

# OIDC discovery URL for JWT-based authentication. Required to enable
# the entitlement-resolved auth path.
# OIDC_DISCOVERY_URL=https://auth.example.com/.well-known/openid-configuration

# Legacy single-audience match. Superseded by RESOURCE_URI_ALLOWLIST below
# but still honored when the allowlist is empty (transitional fallback).

# -----------------------------------------------------------------------------
# Authentication — JWT validation contract
# -----------------------------------------------------------------------------

# Comma-separated list of acceptable `iss` claim values. Tokens from
# unlisted issuers are rejected even if their signature validates against
# a trusted JWKS — defense against confused-deputy attacks across
# applications sharing an IDP.
# OIDC_ISSUER_ALLOWLIST=https://auth.example.com

# Comma-separated list of acceptable `aud` claim values. ADFS deployments
# carry the resource URI in `aud`; this allowlist enumerates the
# resource URIs this registry accepts.
# RESOURCE_URI_ALLOWLIST=https://registry.example.com

# Comma-separated list of acceptable `azp` (or `client_id`) values for
# service tokens. Empty list = check skipped (NOT recommended in
# production — any token issued by a trusted JWKS would pass the
# service-token guard).
# OIDC_CLIENT_ID_ALLOWLIST=

# Registry-enforced upper bound on token lifetime (defense-in-depth
# against IDP misconfiguration that could issue long-lived tokens).
# OIDC_MAX_TOKEN_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# Authentication — entitlement service
# -----------------------------------------------------------------------------
# The entitlement-resolved auth path is enabled by setting
# ENTITLEMENT_SERVICE_URL. The X-Tenant-ID header is the tenant
# selector; stale-on-failure is mandatory and bounded by JWT exp (no
# operator toggle).

# Base URL of the enterprise entitlement service.
# ENTITLEMENT_SERVICE_URL=https://entitlement.example.com

# `env` query parameter passed to the entitlement service (PRD, NPD,
# DEV). Required if ENTITLEMENT_SERVICE_URL is set.
# ENTITLEMENT_SERVICE_ENV=DEV

# Per-deployment middle token of the entitlement grammar
# `<tenant_slug>_<DISCRIMINATOR>_<ROLE>`. Multiple registry-shaped
# services may share one entitlement endpoint with different
# discriminators (REGISTRY, GRAPHREGISTRY, DATA_CATALOG, …). Required
# if ENTITLEMENT_SERVICE_URL is set; non-empty; no internal whitespace.
ENTITLEMENT_SERVICE_DISCRIMINATOR=REGISTRY

# External-suffix → internal-role mapping. Comma-separated EXTERNAL:internal
# pairs. Multiple external suffixes may map to the same internal role
# (covers LDAP rename rollouts with concurrent old/new strings).
# Internal roles must be in {admin, producer, consumer, auditor}.
# Required if ENTITLEMENT_SERVICE_URL is set.
ENTITLEMENT_ROLE_MAPPING=ADMIN:admin,PRODUCER:producer,CONSUMER:consumer,AUDITOR:auditor

# HTTP timeouts for entitlement-service calls. The auth hot path runs
# this on every cache miss; bounded failure behavior prevents request
# thread pile-up on a slow upstream.
# ENTITLEMENT_CONNECT_TIMEOUT_MS=250
# ENTITLEMENT_READ_TIMEOUT_MS=1500

# Maximum retries on network failure / 5xx / 429. Must be 0 or 1.
# ENTITLEMENT_MAX_RETRIES=1

# In-process LRU cache size bound for entitlement responses (per
# process). TTL is bounded by the JWT's own `exp`, not this setting.
# ENTITLEMENT_CACHE_MAX_ENTRIES=10000

# -----------------------------------------------------------------------------
# Progression
# -----------------------------------------------------------------------------

# TTL (seconds) for the cached progression-definition lookup. Short TTL keeps
# the cache fresh after operator edits. 0 disables caching entirely.
PROGRESSION_DEFINITION_CACHE_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------


# In-process token-bucket rate limiting (per tenant, per minute).
# RATE_LIMIT_ENABLED=true disables enforcement when set to false/0/no without
# requiring a redeployment.  Separate budgets for reads (GET/HEAD) and writes
# (POST/PUT/PATCH/DELETE).  In a multi-process deployment each worker process
# holds its own bucket state; effective limit across N workers is up to
# N × per_minute.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WRITE_PER_MINUTE=60
# These per-minute knobs are the rate limiter's real configuration. Two
# per-second variables (DEFAULT_READS_PER_SECOND / DEFAULT_WRITES_PER_SECOND)
# used to be documented here; nothing ever read them, and tuning them changed
# nothing — they are gone rather than kept as decoys.
RATE_LIMIT_READ_PER_MINUTE=600

# --- Usage recording -------------------------------------------------------
# How long raw usage events are kept, in days. Permitted band: 30-180.
#
# A value outside the band is refused at startup rather than clamped: a
# deployment that asked for a year and silently got 180 days would believe it had
# a year of raw history and discover otherwise only when a query returned less
# than it should, by which point the rows are gone.
#
# Aggregate answers are unaffected by this setting. Daily rollups carry no actor
# identifier, are therefore not personal data, and are retained indefinitely — so
# a report for a closed month stays reproducible long after its raw rows expire.
USAGE_RETENTION_DAYS=90

# --- Metrics exposition ---------------------------------------------------
# Bearer credential the Prometheus scraper must present on GET /metrics.
#
# REQUIRED. There is no default and no fallback to unauthenticated serving:
# with this unset, /metrics returns 503 and serves nothing. That is
# deliberate. The exposition publishes process-global counters — the full
# route table, entitlement-failure counts, rate-limit rejections, and the MCP
# tool catalog with per-tool call counts — and /metrics is a rate-limit bypass
# prefix, so an open endpoint is unauthenticated and unthrottled.
#
# Generate one per deployment, e.g. `openssl rand -hex 32`, and put it in the
# scraper's own authorization block. Never commit a real value.
METRICS_BEARER_TOKEN=

# -----------------------------------------------------------------------------
# OpenTelemetry
# -----------------------------------------------------------------------------

# OTLP HTTP endpoint for trace export (e.g. Jaeger, Honeycomb, Tempo, OTel
# Collector). Leave unset to disable tracing.
# OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# Service name used in OTel resource attributes.
SERVICE_NAME=registry

# Per-attempt timeout (seconds) for OTLP span export.  Caps how long the
# BatchSpanProcessor worker thread can block on a slow or unreachable collector.
# Shorter values fail fast and keep the span queue from filling; longer values
# tolerate a sluggish collector but risk queue pressure under high span volume.
# Default: 2. Raise only if your collector is reliably slow but functional.
# OTLP_EXPORTER_TIMEOUT_S=2

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# LOG_FORMAT controls log output: "json" for structured JSON to stdout (production
# default), "text" for human-readable plain text (local development).
LOG_FORMAT=json

# LOG_LEVEL is the root logger level. DEBUG surfaces SQLAlchemy queries and
# OpenTelemetry SDK internals — high volume; reserve for diagnosis.
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Sync connectors
# -----------------------------------------------------------------------------

# Per-connector run timeout (seconds). Applies to the full connector
# coroutine including pagination.
CONNECTOR_RUN_TIMEOUT_S=300

# Webhook secrets — set at deployment time, not in this file. Settings
# checks these first; registry/ingest/webhook.py falls back to os.environ as a
# per-instance secret override (allows rotation without a settings reload).
# GITHUB_WEBHOOK_SECRET=<set-in-secret-store>
# GITLAB_WEBHOOK_SECRET=<set-in-secret-store>

# Per-connector credentials are resolved by a dynamic ref string at run
# time (registry/ingest/connector.py:resolve_credential), so they are NOT in Settings
# — set them in the deployment's secret store under the names the
# connector definitions request.

# -----------------------------------------------------------------------------
# Performance / SLO
# -----------------------------------------------------------------------------


# Partition fan-out for the embeddings table (HASH-partitioned).
EMBEDDINGS_PARTITION_COUNT=8

# -----------------------------------------------------------------------------
# Closure refresh worker
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# Agent Readiness Context (ARC)
# -----------------------------------------------------------------------------

# Exact `issuer|subject` pairs permitted to write deployment-wide governance:
# global artifacts, approval-verifier revocation, and approval-evidence
# revocation. Comma-separated; the delimiter between issuer and subject is `|`
# because issuers are URLs and contain colons.
#
#   ARC_GLOBAL_OPERATOR_ALLOWLIST=https://idp.example.com/realms/ops|svc-arc-operator
#
# This is deliberately NOT a role. Every role in this system is tenant-scoped —
# each tenant has its own admins — so no role can serve as the deployment trust
# root. Membership here is an identity no tenant can grant itself.
#
# Empty (the default) grants nobody. A deployment that configured nothing must
# not fall open on the one surface that binds every tenant. Startup FAILS on a
# malformed entry rather than skipping it: a silently dropped entry means an
# operator who believes they have access and does not.
#
# Audit records a fingerprint of this list, never its membership.
ARC_GLOBAL_OPERATOR_ALLOWLIST=

# Whether the model-backed drafter may serve at all. Off by default,
# including when this variable is absent entirely -- not merely when it is
# set to a falsy string. The decision that could ever justify turning this
# on is a committed artifact (registry/arc/drafter/model_decision.json),
# evaluated against a version-controlled fixture corpus, not a runtime
# toggle: startup refuses to honor `true` here unless that artifact records
# `accepted` with every evaluation gate passed and a matching model-artifact
# digest.
ARC_DRAFTER_MODEL_ENABLED=false

# Filesystem path to the deployment-local model artifact ARC_DRAFTER_MODEL_ENABLED
# would turn on. Only read when that flag is true; its SHA-256 must equal the
# decision artifact's recorded model_artifact_digest.
ARC_DRAFTER_MODEL_ARTIFACT_PATH=

# Which build produced this deployment, recorded in the provenance of every
# context receipt. A replay years later compares it against the build that
# produced the original: without it, "the same manifest resolves differently
# now" cannot be told apart from tampering.
#
# Defaults to `unknown` rather than to a plausible-looking value. A receipt
# asserting a revision that was never deployed is worse than one admitting the
# deployment did not say. Set it from CI — typically the commit SHA.
#
#   BUILD_REVISION=$(git rev-parse HEAD)
#
BUILD_REVISION=
