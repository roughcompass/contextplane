# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build artifacts
dist/
build/

# OS
.DS_Store

# Local env (operator-provided secrets). .env.example is the tracked spec.
.env
.env.*
!.env.example

# Local dev stack: Postgres data directory, service logs, PID state, and
# the generated environment file. Entirely reproducible from `make dev-up`.
.devstack/

# Coverage data. The unit target writes these on every run (the ratchet in
# CLAUDE.md's Testing section); they are machine-local measurements, not
# artifacts, and a dirty tree after `make test-unit` makes every later
# `git status` read as uncommitted work.
.coverage
.coverage.*
